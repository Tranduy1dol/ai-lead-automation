# Local demonstration values only; use separate secrets for deployment.
PORT=8080
POSTGRES_USER=lead
POSTGRES_PASSWORD=local-demo-only
POSTGRES_DB=ai_lead_automation
POSTGRES_PORT=5432
# Used by native Go commands. Compose constructs its own URL using db:5432.
DATABASE_URL=postgres://lead:local-demo-only@localhost:5432/ai_lead_automation?sslmode=disable
CLASSIFIER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DISCORD_WEBHOOK_URL=
# Opt in to tests that create their own disposable Docker PostgreSQL container.
RUN_POSTGRES_TESTS=0
